{
  "name": "wheelsparrow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.18.x",
    "pnpm": "11.15.x"
  },
  "scripts": {
    "build": "pnpm -r --sort run build",
    "fix": "biome check --write . && markdownlint-cli2 --fix \"**/*.md\"",
    "lint": "biome check . && markdownlint-cli2 \"**/*.md\"",
    "live-smoke": "node scripts/live-smoke.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "test:unit": "vitest run",
    "test:prompts": "vitest run apps/server/src/agents/builder.test.ts apps/server/src/agents/reviewer.test.ts apps/server/src/agents/repair.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p tsconfig.tests.json --noEmit",
    "verify:policy": "vitest run scripts/repository-policy.test.ts",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "verify:workflows": "vitest run scripts/workflow-policy.test.ts",
    "verify:agent": "pnpm verify:toolchain && pnpm install --frozen-lockfile && pnpm lint && pnpm typecheck && pnpm test:unit",
    "verify:actionlint": "actionlint && zizmor .github/workflows && pnpm verify:workflows",
    "verify:security": "pnpm verify:policy"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@biomejs/biome": "2.5.8",
    "@types/node": "24.13.3",
    "markdownlint-cli2": "0.23.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
